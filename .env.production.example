PORT=3000
BACKEND_URL=https://roomies.cs.colman.ac.il
NODE_ENV=production
BOT_TOKEN=<The Telegram Bot Token>
WEBSITE_MANUAL_URL=https://roomies.cs.colman.ac.il

JWT_SECRET=<Freshly generated JWT secret - do not reuse the dev one>
JWT_REFRESH_SECRET=<Freshly generated JWT refresh secret - do not reuse the dev one>
JWT_EXP=15m
JWT_REFRESH_EXP=7d

GOOGLE_CLIENT_ID=<The Google Client ID>
GOOGLE_CLIENT_SECRET=<The Google OAuth2 Client Secret>
GOOGLE_CALENDAR_REDIRECT_URI=https://roomies.cs.colman.ac.il/api/google-calendar/callback
FRONTEND_URL=https://roomies.cs.colman.ac.il
GEMINI_API_KEY=<The Gemini API Key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RETRY_MODEL=gemini-2.5-flash

# Connection string to the machine's native Postgres (network_mode: host means
# the container reaches it via 127.0.0.1, same as if running outside Docker)
DATABASE_URL=postgresql://roomies_user:<password>@127.0.0.1:5432/roomies
